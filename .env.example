# Servidor
PORT=3000

# Evolution API
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=sua-chave-api-global-ou-da-instancia
EVOLUTION_INSTANCE=nome-da-sua-instancia

# OpenAI (necessário para transcrição de áudio)
OPENAI_API_KEY=sk-...

# Opcional: números autorizados (separados por vírgula, sem + ou espaços)
# Exemplo: 5511999999999,5511888888888
# Se vazio, qualquer número pode usar o bot
ALLOWED_NUMBERS=

# Caminho do banco de dados SQLite
DATABASE_PATH=./data/financeiro.db
